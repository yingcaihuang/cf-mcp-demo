{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "racore-cdn-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // ───────────────────────────────────────────────────────────────────
  // 明文环境变量。可安全进版本库，部署向导里也可修改。
  // ───────────────────────────────────────────────────────────────────
  "vars": {
    // Racore OpenAPI 的网关地址。官方文档的 OpenAPI spec 里 servers 为空，
    // 请按控制台/客户经理提供的实际地址确认后修改。
    "RACORE_API_BASE_URL": "https://api.racorecloud.com",

    // 计算签名时 request_timestamp 的格式：
    //   "rfc1123" —— 与 x-request-date 请求头完全一致（默认，贴合文档措辞）
    //   "unix"    —— Unix 秒级时间戳字符串
    // 首次鉴权若因签名失败被拒，代码会自动用另一种格式重试一次。
    "RACORE_SIGNATURE_TIMESTAMP_MODE": "rfc1123"
  },

  // ───────────────────────────────────────────────────────────────────
  // 密钥声明。这里只写「名字」，不写值 —— 值由部署向导或 wrangler secret
  // 交互式录入，加密存储在 Cloudflare，不会进版本库。
  //
  // 声明后带来三个好处：
  //   1. wrangler deploy / versions upload 时若密钥未配置，会直接报错而不是
  //      部署出一个运行时才失败的版本
  //   2. wrangler dev 本地缺失时给出警告
  //   3. 接管 wrangler types 的类型生成，Env 类型由此推导，无需手写维护
  //
  // 注意：此字段不会从顶层继承到命名环境，若将来新增 env.staging 等
  // 需要在每个环境里重复声明。
  // ───────────────────────────────────────────────────────────────────
  "secrets": {
    "required": ["RACORE_ACCESS_KEY", "RACORE_SECRET_KEY"]
  }
}
