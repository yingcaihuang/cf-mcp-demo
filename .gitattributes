# 统一换行为 LF，避免跨平台协作出现整文件 diff
* text=auto eol=lf

*.ts   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.ico binary

# 锁文件在 diff / review 中折叠，减少噪音
package-lock.json -diff linguist-generated=true
