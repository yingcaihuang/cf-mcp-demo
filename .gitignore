# 依赖
node_modules/

# 构建产物
dist/
.wrangler/

# Wrangler 从 wrangler.jsonc 生成的运行时类型，由 postinstall 自动重建
worker-configuration.d.ts

# 本地密钥。只有 .dev.vars.example 可以进版本库
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*

# scripts/deploy.sh 生成的临时密钥文件。正常情况下脚本退出即删除，
# 这条规则是为了防止脚本被强制终止后残留的文件被误提交。
.secrets.deploy.*.json

# 日志
*.log
npm-debug.log*
yarn-error.log*

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
